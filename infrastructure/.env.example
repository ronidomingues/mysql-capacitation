# ============================================================
# .env.example — modelo de configuração (SEM segredos)
# ============================================================
# Este arquivo É versionado. O .env real NÃO é (ver .gitignore).
#
# Para usar:
#     cp .env.example .env
#     # gere a senha do root:
#     openssl rand -base64 24 | tr -dc 'A-Za-z0-9' ; echo
#     # cole no MYSQL_ROOT_PASSWORD abaixo e suba o ambiente:
#     docker compose up -d
#
# Alterou algo aqui depois de já ter subido? Os scripts de init/
# só reaplicam com o volume zerado:
#     docker compose down -v && docker compose up -d
# ============================================================

# --- Conta administrativa (SOMENTE o instrutor) --------------
# ⚠️ Durante a aula este servidor fica exposto na internet pelo ngrok.
# NÃO use "root": qualquer varredura automática tenta isso primeiro.
# Gere uma senha longa e aleatória com o comando do cabeçalho.
MYSQL_ROOT_PASSWORD=

# --- Conta dos alunos (compartilhada pela turma) -------------
# Pode ser fraca de propósito: é ditada em voz alta no início da aula
# e só tem privilégio sobre bancos com nome 'liga_*'
# (ver init/01_create_databases.sql).
MYSQL_USER=aluno
MYSQL_PASSWORD=aluno

# --- Portas no SEU host --------------------------------------
MYSQL_PORT=3307
PHPMYADMIN_PORT=90

# --- ngrok (perfil opcional "tunnel") ------------------------
# Token gratuito em:
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Preencha SOMENTE se o phpMyAdmin quebrar atrás do túnel (links/CSS
# errados). Procedimento completo em infrastructure/README.md.
# Ex.: PMA_ABSOLUTE_URI=https://abc-123.ngrok-free.app/
PMA_ABSOLUTE_URI=
