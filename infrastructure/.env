# ============================================================
# .env — ambiente da capacitação de MySQL
# ============================================================
# Alterou algo aqui? Os scripts de init/ só reaplicam com o volume zerado:
#     docker compose down -v && docker compose up -d
# ============================================================

# --- Conta administrativa (SOMENTE o instrutor) --------------
# ⚠️ Durante a aula este servidor fica exposto na internet pelo ngrok.
# "root/root" seria adivinhado por qualquer varredura automática, então
# esta senha foi gerada aleatoriamente. Guarde-a — é com ela que você
# entra no phpMyAdmin para trabalhar no banco 'cap'.
MYSQL_ROOT_PASSWORD=root

# --- Conta dos alunos (compartilhada pela turma) -------------
# Pode ser fraca de propósito: é ditada em voz alta no início da aula e
# só tem privilégio sobre bancos com nome 'liga_*' (ver init/01_...sql).
MYSQL_USER=aluno
MYSQL_PASSWORD=aluno

# --- Portas no SEU host --------------------------------------
MYSQL_PORT=3307
PHPMYADMIN_PORT=90

# --- ngrok (perfil opcional "tunnel") ------------------------
# Pegue o token em https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Preencha SOMENTE se o phpMyAdmin quebrar atrás do túnel (links/CSS
# errados). Procedimento completo em materials/ngrok/README.md.
# Ex.: PMA_ABSOLUTE_URI=https://abc-123.ngrok-free.app/
PMA_ABSOLUTE_URI=
